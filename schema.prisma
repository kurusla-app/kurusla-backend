// Prisma şeması - Kurusla Backend
// Python için prisma-client-py kullanılacak

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  firstName    String?
  lastName     String?
  role         UserRole      @default(USER)
  balance      Float         @default(0)
  groupId      Int?
  group        Group?        @relation(fields: [groupId], references: [id])
  transactions Transaction[]
  savings      Saving[]
  rule         UserRule?
  fcmToken     String?
  badges       UserBadge[]
  ailogs       AILog[]
  stats        UserStats?
  potRequests  PotRequest[]
  createdAt    DateTime      @default(now())
}

model AILog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  toolName   String
  parameters Json
  response   Json?
  createdAt  DateTime @default(now())
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String
  icon        String?
  users       UserBadge[]
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}

model UserRule {
  id           Int      @id @default(autoincrement())
  roundUpStep  Float    @default(10.0)
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
}

model Group {
  id           Int      @id @default(autoincrement())
  name         String
  inviteCode   String   @unique
  totalSavings Float    @default(0)
  users        User[]
  pots         Pot[]
  createdAt    DateTime @default(now())
}

model Pot {
  id           Int              @id @default(autoincrement())
  name         String
  targetAmount Float
  currentAmount Float           @default(0)
  image        String?
  groupId      Int
  group        Group            @relation(fields: [groupId], references: [id])
  participants PotParticipant[]
  requests     PotRequest[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
}

model PotParticipant {
  id        Int      @id @default(autoincrement())
  userId    Int
  potId     Int
  pot       Pot      @relation(fields: [potId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([userId, potId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PotRequest {
  id        Int           @id @default(autoincrement())
  potId     Int
  pot       Pot           @relation(fields: [potId], references: [id])
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  amount    Float
  type      String        // "CONTRIBUTION" veya "WITHDRAWAL"
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  merchant  String
  category  String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  saving    Saving?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([merchant])
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Saving {
  id            Int               @id @default(autoincrement())
  amount        Float
  transactionId Int               @unique
  transaction   Transaction       @relation(fields: [transactionId], references: [id])
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  status        TransactionStatus @default(PENDING)
  retryCount    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model MerchantCategory {
  id       Int    @id @default(autoincrement())
  name     String @unique // Örn: Starbucks
  category String         // Örn: Food & Drink
  icon     String?        // Örn: coffee-icon
}

model UserStats {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id])
  totalSavings      Float    @default(0)
  totalTransactions Int      @default(0)
  lastUpdate        DateTime @updatedAt
}
