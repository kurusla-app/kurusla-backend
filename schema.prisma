// Prisma şeması - Kurusla Backend
// Python için prisma-client-py kullanılacak

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/// Kullanıcının tercih ettiği yuvarlama limiti (5, 10 veya 50 TL)
enum RoundUpStep {
  STEP_5
  STEP_10
  STEP_50
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ReferralRewardType {
  BALANCE_KURUS
  AGESA_PROMO
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  firstName    String?
  lastName     String?
  role         UserRole      @default(USER)
  balance      Float         @default(0)
  groupId      Int?
  group        Group?        @relation(fields: [groupId], references: [id])
  transactions Transaction[]
  savings      Saving[]
  rule         UserRule?
  fcmToken     String?
  badges       UserBadge[]
  ailogs       AILog[]
  stats        UserStats?
  potRequests      PotRequest[]
  potParticipants  PotParticipant[]
  createdPots      Pot[]            @relation("PotCreator")
  referralCode     String?          @unique
  referredById     Int?
  referredBy       User?            @relation("UserReferrals", fields: [referredById], references: [id])
  invitedUsers     User[]           @relation("UserReferrals")
  referralsMade    Referral[]       @relation("Referrer")
  referralReceived Referral?        @relation("ReferredUser")
  createdAt        DateTime         @default(now())
}

/// Davet Et Kazan — davet eden ile yeni üye ilişkisi
model Referral {
  id               Int                @id @default(autoincrement())
  referrerId       Int
  referrer         User               @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId   Int                @unique
  referredUser     User               @relation("ReferredUser", fields: [referredUserId], references: [id])
  status           ReferralStatus     @default(PENDING)
  rewardType       ReferralRewardType @default(BALANCE_KURUS)
  referrerReward   Float              @default(0)
  referredReward   Float              @default(0)
  createdAt        DateTime           @default(now())
  completedAt      DateTime?

  @@index([referrerId])
  @@index([status])
}

model AILog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  toolName   String
  parameters Json
  response   Json?
  createdAt  DateTime @default(now())
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String
  icon        String?
  users       UserBadge[]
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}

/// Kullanıcı yuvarlama kuralı (görev dokümanındaki "Rule" tablosu)
model UserRule {
  id           Int          @id @default(autoincrement())
  roundUpStep  RoundUpStep  @default(STEP_10)
  userId       Int          @unique
  user         User         @relation(fields: [userId], references: [id])
}

/// Kuruşla Paylaş — ortak birikim grubu
model Group {
  id           Int      @id @default(autoincrement())
  name         String
  inviteCode   String   @unique
  totalSavings Float    @default(0)
  users        User[]
  pots         Pot[]
  createdAt    DateTime @default(now())
}

/// Grup içindeki ortak birikim hedefi (Pot / kumbara)
model Pot {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  targetAmount  Float
  currentAmount Float            @default(0)
  image         String?
  groupId       Int
  group         Group            @relation(fields: [groupId], references: [id])
  createdById   Int?
  createdBy     User?            @relation("PotCreator", fields: [createdById], references: [id])
  participants  PotParticipant[]
  requests      PotRequest[]
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())

  @@index([groupId])
}

/// Kullanıcı ↔ Pot: birden fazla kişi aynı hedefe katkı sunar
model PotParticipant {
  id               Int      @id @default(autoincrement())
  userId           Int
  potId            Int
  user             User     @relation(fields: [userId], references: [id])
  pot              Pot      @relation(fields: [potId], references: [id])
  totalContributed Float    @default(0)
  joinedAt         DateTime @default(now())

  @@unique([userId, potId])
  @@index([userId])
  @@index([potId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PotRequestType {
  CONTRIBUTION
  WITHDRAWAL
}

model PotRequest {
  id        Int            @id @default(autoincrement())
  potId     Int
  pot       Pot            @relation(fields: [potId], references: [id])
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  amount    Float
  type      PotRequestType
  status    RequestStatus  @default(PENDING)
  createdAt DateTime       @default(now())

  @@index([potId])
  @@index([userId])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  merchant  String
  category  String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  saving    Saving?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([merchant])
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Saving {
  id            Int               @id @default(autoincrement())
  amount        Float
  transactionId Int               @unique
  transaction   Transaction       @relation(fields: [transactionId], references: [id])
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  status        TransactionStatus @default(PENDING)
  retryCount    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model MerchantCategory {
  id       Int    @id @default(autoincrement())
  name     String @unique // Örn: Starbucks
  category String         // Örn: Food & Drink
  icon     String?        // Örn: coffee-icon
}

model UserStats {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id])
  totalSavings      Float    @default(0)
  totalTransactions Int      @default(0)
  lastUpdate        DateTime @updatedAt
}
