// Prisma şeması - Kurusla Backend
// Python için prisma-client-py kullanılacak

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  binaryTargets        = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  balance      Float         @default(0)
  groupId      Int?
  group        Group?        @relation(fields: [groupId], references: [id])
  transactions Transaction[]
  savings      Saving[]
  rule         UserRule?
  createdAt    DateTime      @default(now())
}

model UserRule {
  id           Int      @id @default(autoincrement())
  roundUpStep  Float    @default(10.0)
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
}

model Group {
  id           Int      @id @default(autoincrement())
  name         String
  inviteCode   String   @unique
  totalSavings Float    @default(0)
  users        User[]
  createdAt    DateTime @default(now())
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  merchant  String
  category  String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  saving    Saving?
  createdAt DateTime @default(now())
}

model Saving {
  id            Int         @id @default(autoincrement())
  amount        Float
  transactionId Int         @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
}

model MerchantCategory {
  id       Int    @id @default(autoincrement())
  name     String @unique // Örn: Starbucks
  category String         // Örn: Food & Drink
  icon     String?        // Örn: coffee-icon
}
