{
  "name": "kurusla-backend",
  "version": "1.0.0",
  "description": "**Kurusla**, kullanıcıların harcamalarını takip ederek otomatik birikim yapmasını sağlayan bir fintech çözümüdür. Bu sürüm, **Python**, **FastAPI** ve **Prisma** ile geliştirilmiştir.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test:load:smoke": "k6 run load-tests/k6/spending-smoke.js",
    "test:load": "k6 run load-tests/k6/spending-load.js",
    "test:load:stress": "k6 run load-tests/k6/spending-stress.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurusla-app/kurusla-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kurusla-app/kurusla-backend/issues"
  },
  "homepage": "https://github.com/kurusla-app/kurusla-backend#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
